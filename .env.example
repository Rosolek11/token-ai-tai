# Copy values into your local .env or deployment environment. Never commit secrets.
DATABASE_URL=sqlite:///./token_ai.db
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Empty means the website calls its own origin. Set an HTTPS URL if the API is hosted separately.
PUBLIC_API_BASE_URL=

# Optional until the corresponding data integrations are implemented.
RUGCHECK_API_KEY=
BIRDEYE_API_KEY=
SOLSCAN_API_KEY=
GMGN_API_KEY=
AI_API_KEY=
OPENROUTER_API_KEY=
BAZAARLINK_API_KEY=

# GitHub OAuth App. Callback: ${TAI_PUBLIC_ORIGIN}/api/auth/github/callback
# Use github_copilot for individually signed-in users, or api for the providers above.
AI_PROVIDER=api
TAI_PUBLIC_ORIGIN=http://localhost:8000
# Enable first-use registration exclusively on a local development server.
GITHUB_LOCAL_SETUP=0
# Use 1 when manually supplying credentials for a GitHub App instead of an OAuth App.
GITHUB_APP=0
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
